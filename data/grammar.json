[{"category": "1. Частицы существительных (조사)", "items": [{"pattern": "N-이/가", "desc": "подлежащее", "lesson": "1과", "group": "Падежные"}, {"pattern": "N-을/를", "desc": "прямое дополнение", "lesson": "3과", "group": "Падежные"}, {"pattern": "N-의", "desc": "притяжательность, \"чей\"", "lesson": "2과", "group": "Падежные"}, {"pattern": "N-은/는①", "desc": "топик-маркер, тема", "lesson": "1과", "group": "Тема / контраст"}, {"pattern": "N-은/는②", "desc": "контраст, \"а...\"", "lesson": "7과", "group": "Тема / контраст"}, {"pattern": "N-에①", "desc": "статичное место/момент времени", "lesson": "2과", "group": "Место и время"}, {"pattern": "N-에②", "desc": "календарное использование (даты)", "lesson": "4과", "group": "Место и время"}, {"pattern": "N-에서", "desc": "место действия / \"из\"", "lesson": "2과, закреп. 4과", "group": "Место и время"}, {"pattern": "N-부터...N-까지", "desc": "\"с... до...\"", "lesson": "5과", "group": "Место и время"}, {"pattern": "N-동안", "desc": "\"в течение, во время\"", "lesson": "8과", "group": "Место и время"}, {"pattern": "N-(으)로①", "desc": "направление \"в сторону\"", "lesson": "7과", "group": "Направление и способ"}, {"pattern": "N-(으)로②", "desc": "способ/средство передвижения \"на чём\"", "lesson": "13과", "group": "Направление и способ"}, {"pattern": "N-와/과", "desc": "нейтральное/письменное \"и\"", "lesson": "4과", "group": "Соединение существительных (\"и\")"}, {"pattern": "N-하고", "desc": "разговорное \"и\"", "lesson": "4과", "group": "Соединение существительных (\"и\")"}, {"pattern": "N-이랑", "desc": "самое разговорное \"и\"", "lesson": "9과", "group": "Соединение существительных (\"и\")"}, {"pattern": "N-보다", "desc": "\"чем\"", "lesson": "15과", "group": "Сравнение"}, {"pattern": "N-에게(서)/한테(서)", "desc": "нейтрально/разговорно, для людей", "lesson": "9과", "group": "Дательный падеж (кому/от кого)"}, {"pattern": "N-께", "desc": "почтительная версия, для уважаемых", "lesson": "16과", "group": "Дательный падеж (кому/от кого)"}, {"pattern": "N-도", "desc": "\"тоже\" (заменяет 이/가, 을/를)", "lesson": "1과", "group": "Прочее"}, {"pattern": "N-만", "desc": "\"только\"", "lesson": "3과", "group": "Прочее"}, {"pattern": "N-(이)나", "desc": "\"или\" между существительными", "lesson": "13과", "group": "Прочее"}, {"pattern": "수①②③④", "desc": "числительные (исконно корейские, китайско-корейские, для цен)", "lesson": "3, 4, 9과", "group": "Прочее"}], "tips": ""}, {"category": "2. Именное сказуемое (N이다) и его формы", "items": [{"pattern": "N-입니다/입니까?", "desc": "формальное \"N является\"", "lesson": "1과", "group": null}, {"pattern": "N-이에요/예요", "desc": "разговорное вежливое \"N является\"", "lesson": "5과; 예요 после гласной, 이에요 после согласной", "group": null}, {"pattern": "N-이었/였-", "desc": "прошедшее время связки", "lesson": "6과", "group": null}, {"pattern": "N-이/가 아니다", "desc": "\"это не N\"", "lesson": "1과, отриц.", "group": null}, {"pattern": "N-(이)고", "desc": "\"N — это... и\" (перечисление через связку)", "lesson": "6과", "group": null}, {"pattern": "N-(이)지만", "desc": "\"N, но...\"", "lesson": "15과", "group": null}, {"pattern": "N-(이)면", "desc": "\"если N\"", "lesson": "11과", "group": null}, {"pattern": "N-(이)니까", "desc": "\"т.к. N, поэтому...\"", "lesson": "10과", "group": null}, {"pattern": "N-(이)지요?", "desc": "\"N, ведь так?\"", "lesson": "11과", "group": null}, {"pattern": "N-일까요?", "desc": "\"интересно, N ли?\"", "lesson": "12과", "group": null}, {"pattern": "N-일 거예요", "desc": "\"наверное, N\" (предположение)", "lesson": "12과", "group": null}, {"pattern": "N인 N", "desc": "\"N2, который есть N1\"", "lesson": "16과", "group": null}, {"pattern": "N인데", "desc": "\"N, но при этом / а...\"", "lesson": "16과", "group": null}], "tips": ""}, {"category": "3. Время и вид глагола", "items": [{"pattern": "V-아/어/여요①", "desc": "настоящее время, разговорно-вежливое (해요체)", "lesson": "5과", "group": null}, {"pattern": "V-(스)ㅂ니다/까", "desc": "настоящее время, формальное (습니다체)", "lesson": "3과", "group": null}, {"pattern": "V-았/었/였-", "desc": "прошедшее время", "lesson": "6과", "group": null}, {"pattern": "AV-고 있다①", "desc": "настоящее длительное, \"делаю прямо сейчас\"", "lesson": "9과", "group": null}, {"pattern": "AV-(으)ㄹ 거예요①", "desc": "будущее, своё намерение", "lesson": "8과", "group": null}, {"pattern": "AV-(으)ㄹ 거예요②", "desc": "будущее/предположение о чужом действии", "lesson": "12과", "group": null}, {"pattern": "V-겠-①", "desc": "твёрдое намерение \"я сделаю\" (1-е лицо, формально)", "lesson": "10과", "group": null}, {"pattern": "V-겠-②", "desc": "предположение \"наверное, должно быть\"", "lesson": "11과", "group": null}], "tips": "**Как выбрать между похожими:**\n- Своё будущее намерение → -(으)ㄹ 거예요① (обычно) или -겠어요 (более формально/решительно)\n- Предположение о чужом/непроверяемом факте → -(으)ㄹ 거예요② или -겠어요② (② реакция здесь-и-сейчас на что-то увиденное/услышанное)\n\n---"}, {"category": "4. Отрицание", "items": [{"pattern": "안 V / V-지 않다", "desc": "обычное отрицание, \"не делаю\"", "lesson": "5과", "group": null}, {"pattern": "N-이/가 아니다", "desc": "именное отрицание, \"это не N\"", "lesson": "1과", "group": null}, {"pattern": "못 V / V-지 못하다", "desc": "невозможность, \"не могу\" (внешние обстоятельства)", "lesson": "13과", "group": null}, {"pattern": "V-지 말다", "desc": "запрет, \"не делай!\" (только глаголы, императив)", "lesson": "14과", "group": null}, {"pattern": "V-(으)면 안 되다", "desc": "\"нельзя\", мягкий/безличный запрет-правило", "lesson": "15과", "group": null}], "tips": "**Как выбрать:** обычное \"не\" → 안/지 않다; \"не могу из-за обстоятельств\" → 못; \"не делай!\" собеседнику → 지 말다; \"так делать нельзя\" как правило → (으)면 안 되다.\n\n---"}, {"category": "5. Соединительные окончания (связывают два действия/предложения)", "items": [{"pattern": "V-고①", "desc": "перечисление действий/фактов, порядок неважен", "lesson": "6과", "group": null}, {"pattern": "V-고②", "desc": "последовательность во времени, \"сделал одно, потом другое\"", "lesson": "8과", "group": null}, {"pattern": "V-아/어서①", "desc": "причина, \"потому что\"", "lesson": "7과", "group": null}, {"pattern": "V-아/어서②", "desc": "последовательность, второе действие зависит от первого, один субъект", "lesson": "12과", "group": null}, {"pattern": "V-(으)면", "desc": "условие, \"если\"", "lesson": "11과", "group": null}, {"pattern": "V-(으)니까", "desc": "причина ПЕРЕД просьбой/предложением/командой", "lesson": "10과", "group": null}, {"pattern": "V-거나", "desc": "\"или\" между действиями", "lesson": "13과", "group": null}, {"pattern": "V-지만", "desc": "\"но, хотя\", прямое противопоставление", "lesson": "15과", "group": null}, {"pattern": "V-는데/(으)ㄴ데/인데", "desc": "мягкий фон/лёгкое \"но\", менее категорично чем 지만", "lesson": "16과", "group": null}], "tips": "**Ключевые развилки:**\n- \"и\" между существительными → 와/과; \"и\" между сказуемыми/действиями → 고\n- Причина + обычное утверждение → 아서/어서; причина + просьба/предложение/команда → (으)니까\n- 고 vs 아서/어서②: субъекты могут различаться и порядок неважен → 고; одно действие логически зависит от другого, тот же субъект → 아서/어서②\n- 지만 vs 는데: 지만 — чёткое \"но\"; 는데 — мягче, часто просто фон/контекст, не обязательно противопоставление\n\n---"}, {"category": "6. Модальность — возможность, необходимость, желание, разрешение", "items": [{"pattern": "AV-(으)ㄹ 수 있다/없다", "desc": "\"могу/не могу\" (способность/возможность)", "lesson": "12과", "group": null}, {"pattern": "V-아/어/야 되다/하다", "desc": "\"должен, нужно\"", "lesson": "14과", "group": null}, {"pattern": "AV-고 싶다", "desc": "\"хочу сделать\" (1-е лицо)", "lesson": "10과", "group": null}, {"pattern": "AV-(으)려고 하다", "desc": "\"собираюсь, намереваюсь\" (осознанный план)", "lesson": "14과", "group": null}, {"pattern": "V-아/어/여도 되다(좋다, 괜찮다)", "desc": "\"можно, разрешается\"", "lesson": "15과", "group": null}], "tips": ""}, {"category": "7. Обращение к собеседнику — просьбы, предложения, вопросы-подтверждения", "items": [{"pattern": "AV-(으)세요/-(으)십시오", "desc": "вежливая просьба/команда", "lesson": "9과", "group": null}, {"pattern": "AV-(으)ㅂ시다", "desc": "\"давайте сделаем\" (прямое предложение, не для старших)", "lesson": "10과", "group": null}, {"pattern": "AV-(으)ㄹ까요?①", "desc": "мягкое предложение \"может, сделаем?\"", "lesson": "10과", "group": null}, {"pattern": "AV-(으)ㄹ까요?②", "desc": "вопрос-предположение \"интересно, ли...?\"", "lesson": "12과", "group": null}, {"pattern": "V-지요?/N(이)지요?", "desc": "вопрос-подтверждение \"ведь так?\"", "lesson": "11과", "group": null}, {"pattern": "AV-(으)ㄹ게요", "desc": "обещание \"я сделаю\" (1-е лицо)", "lesson": "12과", "group": null}, {"pattern": "AV-아/어/여요②", "desc": "та же форма наст. времени, но как мягкий императив/предложение по интонации", "lesson": "13과", "group": null}, {"pattern": "AV-아/어/여 주다", "desc": "\"сделать для кого-то\" (услуга)", "lesson": "11과", "group": null}, {"pattern": "AV-아/어/여 드리다", "desc": "то же самое, но почтительно, для старших", "lesson": "16과, доп. к 11과", "group": null}], "tips": ""}, {"category": "8. Определительные формы (перед существительным, \"какой/который\")", "items": [{"pattern": "이/그/저", "desc": "указательные (\"этот/тот/тот вон\")", "lesson": "2과", "group": null}, {"pattern": "DV-(으)ㄴ N", "desc": "прилагательное перед существительным, одна форма", "lesson": "15과", "group": null}, {"pattern": "AV-(으)ㄴ/는/(으)ㄹ N", "desc": "глагол перед существительным, три формы по времени: прошедшее -은/ㄴ, настоящее -는, будущее -을/ㄹ", "lesson": "16과", "group": null}, {"pattern": "N인 N", "desc": "\"N2, который есть N1\" (именное определение)", "lesson": "16과", "group": null}], "tips": "**Не путать:** прилагательные (DV) имеют только одну определительную форму; глаголы (AV) — три разные формы в зависимости от времени.\n\n---"}, {"category": "9. Опыт и попытка", "items": [{"pattern": "AV-아/어/여 보다", "desc": "\"пробовать, иметь опыт\"", "lesson": "6과", "group": null}], "tips": ""}, {"category": "10. Вежливость к третьему лицу (почтительная речь, 존댓말 о ком-то)", "items": [{"pattern": "N-께서/께서는", "desc": "почтительное подлежащее вместо 이/가, 은/는", "lesson": "14과", "group": null}, {"pattern": "V-(으)시-/N-이시-", "desc": "почтительный суффикс глагола", "lesson": "14과", "group": null}, {"pattern": "N-께", "desc": "почтительное \"кому\" вместо 에게/한테", "lesson": "16과", "group": null}, {"pattern": "AV-아/어/여 드리다", "desc": "почтительное \"делать для\" вместо 주다", "lesson": "16과, доп.", "group": null}], "tips": ""}, {"category": "11. Неправильные спряжения (불규칙)", "items": [{"pattern": "ㅡ 탈락", "desc": "гласная ㅡ выпадает перед -아/어요, смотреть на слог ДО неё", "lesson": "6과", "group": null}, {"pattern": "ㅂ 불규칙", "desc": "받침 ㅂ → 우 (иногда 오: 돕다→도와요, 곱다→고와요) перед гласным окончанием", "lesson": "7과", "group": null}, {"pattern": "ㄷ 불규칙", "desc": "받침 ㄷ → ㄹ перед гласным окончанием", "lesson": "11과", "group": null}, {"pattern": "ㄹ받침 поведение", "desc": "в -아/어요 обычный, но ㄹ выпадает перед -ㅂ니다/-세요/-으세요/-읍시다/-을까요 и т.п.", "lesson": "7, 9, 10과", "group": null}], "tips": ""}]